# Required: only this WhatsApp self-chat is accepted. Include the country code,
# without a leading + sign. Example for an Indian number: 919876543210.
OWNER_JID=919876543210@s.whatsapp.net

# IANA timezone used for the owner's conversational context.
OWNER_TIMEZONE=Asia/Kolkata

# Required outside --self-chat-check mode. Never commit the real key.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash

# Persistent application and WhatsApp session state.
DATABASE_URL=sqlite:///data/bol_bachchan.db
NEONIZE_SESSION_PATH=data/neonize.db

# Worker and clarification settings. Defaults are suitable for the demo.
MESSAGE_QUEUE_SIZE=100
PENDING_ACTION_TTL_MINUTES=30
LOG_LEVEL=INFO

# Reminder delivery and media handling.
REMINDER_POLL_SECONDS=10
WHATSAPP_RECONNECT_INITIAL_SECONDS=5
WHATSAPP_RECONNECT_MAX_SECONDS=60
MEDIA_DIR=data/media
MAX_MEDIA_BYTES=20971520

# Required for full V1 acceptance: Maya text-to-speech. Text remains the failure fallback.
MAYA_API_URL=https://tts.mayaresearch.ai/v1/tts
MAYA_API_KEY=
MAYA_VOICE=Ananya
MAYA_MODEL=Maya 2 Native

# Required for full V1 acceptance: Google Calendar sync for confirmed reminders and events.
# Requires an OAuth client and refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TOKEN_PATH=data/google_calendar_token.json
GOOGLE_OAUTH_REDIRECT_PORT=8765

# Optional HTTP health-check listener for container orchestration.
PORT=8080
